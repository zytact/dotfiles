#!/usr/bin/env sh
# Render ~/cliproxyapi/config.yaml from the dotfiles template and the secrets in ~/.secrets.
# Usage: cliproxyapi-render-config [output-path]
set -eu
[ -f "$HOME/.secrets" ] && . "$HOME/.secrets"
: "${CLIPROXY_API_KEY:?set CLIPROXY_API_KEY in ~/.secrets}"
: "${CLIPROXY_MANAGEMENT_KEY:?set CLIPROXY_MANAGEMENT_KEY in ~/.secrets (plaintext, the proxy hashes it on startup)}"
TEMPLATE="$HOME/dotfiles/cliproxyapi/config.yaml.template"
TARGET="${1:-$HOME/cliproxyapi/config.yaml}"
export CLIPROXY_API_KEY CLIPROXY_MANAGEMENT_KEY
python3 - "$TEMPLATE" "$TARGET" <<'PY'
import os, sys
out = open(sys.argv[1]).read()
for name in ("CLIPROXY_API_KEY", "CLIPROXY_MANAGEMENT_KEY"):
    out = out.replace(f"__{name}__", os.environ[name])
assert "__CLIPROXY_" not in out, "unreplaced placeholder left in template"
fd = os.open(sys.argv[2], os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
with os.fdopen(fd, "w") as f:
    f.write(out)
PY
echo "wrote $TARGET"
