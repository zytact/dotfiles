# Rendered from config.yaml.template by cliproxyapi-render-config. Do not edit.
# Edit the template in dotfiles and re-render instead. Secrets come from
# CLIPROXY_API_KEY / CLIPROXY_MANAGEMENT_KEY in ~/.secrets (never committed).
config-version: 8

server:
  # Tailscale serve forwards tailnet port 8317 here, so nothing binds publicly.
  host: "127.0.0.1"
  port: 8317

management:
  # Tailscale serve connects from localhost, so remote access stays off.
  allow-remote: false
  secret-key: "__CLIPROXY_MANAGEMENT_KEY__"

access:
  api-keys:
    - "__CLIPROXY_API_KEY__"

routing:
  # Keep each session on one account so its prompt cache survives.
  # Only quota and auth errors move it to another account.
  session-affinity: true
  session-affinity-rebind-on: "quota"
  cooldown:
    transient-error-cooldown-seconds: 5

oauth:
  auth-dir: "~/.cli-proxy-api"
