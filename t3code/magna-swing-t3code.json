{
  "version": 1,
  "id": "magna-swing",
  "name": "Magna Swing",
  "appearance": "dark",
  "canvas": "#000000",
  "accent": "#ffffff",
  "colors": {
    "canvas": "#000000",
    "chrome": "#000000",
    "toolbar": "#000000",
    "toolbarBorder": "#000000",
    "sidebar": "#000000",
    "sidebarBorder": "#000000",
    "sidebarRowHover": "#0d0d0d",
    "sidebarRowActive": "#0d0d0d",
    "sidebarRowSelected": "#161616",
    "sidebarControlSurface": "#0d0d0d",
    "surface": "#050505",
    "surfaceRaised": "#0a0a0a",
    "surfaceOverlay": "#0a0a0a",
    "messageSurface": "#000000",
    "messageAction": "#ffffff",
    "messageActionForeground": "#000000",
    "accentForeground": "#000000",
    "text": "#f5f5f5",
    "textMuted": "#a1a1a1",
    "border": "#1f1f1f",
    "input": "#262626",
    "codeBackground": "#070707",
    "terminalBackground": "#000000",
    "terminalCursor": "#f7941d"
  },
  "css": ".dark [data-workspace-area=conversation],.dark [data-chat-composer-overlay]:has([data-chat-composer-stack]>div+div){background:linear-gradient(90deg,rgba(0,0,0,.72),rgba(0,0,0,.86) 14%,rgba(0,0,0,.86) 86%,rgba(0,0,0,.72)),url(\"data:image/avif;base64,\") center/cover no-repeat #000!important}\n.dark .messages-timeline-scroll{background:transparent!important}\n.dark [data-timeline-row-kind]{text-shadow:0 1px 2px #000,0 0 10px rgba(0,0,0,.9)}\n.dark [data-user-message-bubble]{background:rgba(0,0,0,.6)!important;border:1px solid rgba(255,255,255,.16)!important;backdrop-filter:blur(8px)}\n.dark [data-slot=composer-host]{background:rgba(0,0,0,.72)!important;border:1px solid rgba(255,255,255,.14)!important;backdrop-filter:blur(12px);transition:border-color .3s}\n.dark [data-slot=composer-host]:focus-within{border-color:rgba(255,255,255,.4)!important}\n.dark [data-slot=sidebar-inner]{background:#000!important}\n.dark [data-slot=sidebar],.dark [data-slot=sidebar]>*,.dark [data-slot=sidebar-inner]{border-color:transparent!important;box-shadow:none!important}\n"
}
