{
  "$schema": "https://opencode.ai/theme.json",
  "defs": {
    "bg": "#111010",
    "fg": "#cfe7ff",
    "darkNavy": "#0a0f1a",
    "darkBlue": "#1e3a5f",
    "blue": "#4aa3ff",
    "brightBlue": "#7cc4ff",
    "lightBlue": "#dbeafe",
    "veryLightBlue": "#eff6ff",
    "green": "#39ff88",
    "brightGreen": "#7dffb3",
    "cyan": "#22d3ee",
    "brightCyan": "#67e8f9",
    "purple": "#a78bfa",
    "brightPurple": "#c4b5fd",
    "pink": "#ff5faf",
