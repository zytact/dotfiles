{
  "env": {
    "SHELL": "/bin/bash"
  },
  "includeCoAuthoredBy": false,
  "permissions": {
    "deny": [
      "EnterPlanMode",
      "ExitPlanMode",
      "RemoteTrigger"
    ]
  },
  "model": "opus",
  "disableClaudeAiConnectors": true,
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/home/arnab/.claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "input=$(cat); base=$(printf '%s' \"$input\" | npx -y ccstatusline@latest); effort=$(printf '%s' \"$input\" | node -e 'let d=\"\";process.stdin.on(\"data\",c=>d+=c).on(\"end\",()=>{const e=JSON.parse(d).effort;console.log((e&&(e.level??e))||\"unknown\")})'); printf '%s | Effort: %s\\n' \"$base\" \"$effort\"",
    "padding": 0,
    "refreshInterval": 10
  },
  "outputStyle": "Concise",
  "effortLevel": "low",
  "modelSettings": {
    "claude-opus-5": {
      "effortLevel": "medium"
    },
    "claude-sonnet-5-5": {
      "effortLevel": "high"
    },
    "claude-opus-5-5": {
      "effortLevel": "low"
    }
  },
  "promptSuggestionEnabled": false,
  "tui": "fullscreen",
  "voice": {
    "enabled": true,
    "mode": "hold"
  },
  "autoMemoryEnabled": false,
  "skipDangerousModePermissionPrompt": true,
  "theme": "custom:t3-light",
  "autoCompactEnabled": true,
  "agentPushNotifEnabled": true,
  "voiceEnabled": true
}
