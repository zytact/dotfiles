{
  "permissions": {
    "deny": [
      "EnterPlanMode",
      "ExitPlanMode",
      "RemoteTrigger"
    ]
  },
  "model": "sonnet",
  "disableClaudeAiConnectors": true,
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/home/arnab/.claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "input=$(cat); base=$(printf '%s' \"$input\" | npx -y ccstatusline@latest); effort=$(printf '%s' \"$input\" | jq -r '.effort.level // \"unknown\"'); printf '%s | Effort: %s\\n' \"$base\" \"$effort\"",
    "padding": 0,
    "refreshInterval": 10
  },
  "effortLevel": "medium",
  "promptSuggestionEnabled": false,
  "tui": "fullscreen",
  "voice": {
    "enabled": true,
    "mode": "hold"
  },
  "skipDangerousModePermissionPrompt": true,
  "theme": "dark-daltonized",
  "autoCompactEnabled": true,
  "agentPushNotifEnabled": true,
  "voiceEnabled": true
}
