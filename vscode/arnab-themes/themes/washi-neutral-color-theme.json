    "parameter": "#636363",
    "keyword": {
      "foreground": "#3065cd",
      "fontStyle": "italic"
    },
    "comment": {
      "foreground": "#808080",
      "fontStyle": "italic"
    },
    "string": "#457d52",
    "number": "#714085",
    "operator": "#b32130",
    "decorator": "#4a7ad6",
    "selfKeyword": {
      "foreground": "#b32130",
      "fontStyle": "italic"
    },
    "*.deprecated": {
      "fontStyle": "strikethrough"
    },
    "*.readonly": {
      "fontStyle": ""
    }
  }
}