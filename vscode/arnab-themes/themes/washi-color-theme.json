    "decorator": "#d0603d",
    "selfKeyword": {
      "foreground": "#b32130",
      "fontStyle": "italic"
    },
    "*.deprecated": {
      "fontStyle": "strikethrough"
    },
    "*.readonly": {
      "fontStyle": ""
    }
  }
}