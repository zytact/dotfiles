  "tokenColors": [
    {
      "name": "Comment",
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": {
        "foreground": "#947474",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Variable",
      "scope": ["variable", "meta.definition.variable.name", "support.variable", "entity.name.variable"],
      "settings": {
        "foreground": "#ebd9d2"
      }
    },
    {
      "name": "Language variable (this, self, super)",
      "scope": ["variable.language", "variable.parameter.function.language.special"],
      "settings": {
        "foreground": "#ff5a6e",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Parameter",
      "scope": ["variable.parameter", "meta.function.parameters"],
      "settings": {
        "foreground": "#a1837c"
      }
    },
    {
      "name": "Keyword",
      "scope": ["keyword", "keyword.control", "storage.type", "storage.modifier", "keyword.operator.expression", "keyword.operator.new", "keyword.operator.logical"],
      "settings": {
        "foreground": "#f5384f",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Operator",
      "scope": ["keyword.operator", "punctuation.accessor"],
      "settings": {
        "foreground": "#ff5a6e",
        "fontStyle": ""
      }
    },
    {
      "name": "Punctuation",
      "scope": ["punctuation", "meta.brace", "punctuation.separator", "punctuation.terminator", "punctuation.definition.parameters"],
      "settings": {
        "foreground": "#a1837c"
      }
    },
    {
      "name": "String",
      "scope": ["string", "string.quoted", "punctuation.definition.string", "string.template"],
      "settings": {
        "foreground": "#d9a441"
      }
    },
    {
      "name": "String escape and interpolation",
      "scope": ["constant.character.escape", "punctuation.definition.template-expression", "punctuation.section.embedded"],
      "settings": {
        "foreground": "#ff7a29"
      }
    },
    {
      "name": "Regex",
      "scope": ["string.regexp", "constant.regexp"],
      "settings": {
        "foreground": "#f0c98a"
      }
    },
    {
      "name": "Number, constant, boolean",
      "scope": ["constant.numeric", "constant.language", "constant.language.boolean", "constant.language.null", "constant.language.undefined", "support.constant"],
      "settings": {
        "foreground": "#a06fbf"
      }
    },
    {
      "name": "Constant (other)",
      "scope": ["constant", "constant.other.caps", "variable.other.constant"],
      "settings": {
        "foreground": "#a06fbf"
      }
    },
    {
      "name": "Function and method",
      "scope": ["entity.name.function", "support.function", "meta.function-call.generic", "variable.function"],
      "settings": {
        "foreground": "#ff7a29"
      }
    },
    {
      "name": "Type, class, interface",
      "scope": ["entity.name.type", "entity.name.class", "entity.name.namespace", "entity.other.inherited-class", "support.type", "support.class", "storage.type.class", "entity.name.scope-resolution"],
      "settings": {
        "foreground": "#6fbfb2"
      }
    },
    {
      "name": "Property and key",
      "scope": ["variable.other.property", "meta.object-literal.key", "support.type.property-name", "variable.other.object.property"],
      "settings": {
        "foreground": "#9fbcd4"
      }
    },
    {
      "name": "JSON key",
      "scope": ["support.type.property-name.json", "string.json.key"],
      "settings": {
        "foreground": "#9fbcd4"
      }
    },
    {
      "name": "Tag",
      "scope": ["entity.name.tag", "punctuation.definition.tag"],
      "settings": {
        "foreground": "#f5384f"
      }
    },
    {
      "name": "Component tag",
      "scope": ["entity.name.tag.support", "support.class.component"],
      "settings": {
        "foreground": "#6fbfb2"
      }
    },
    {
      "name": "Attribute",
      "scope": ["entity.other.attribute-name", "meta.attribute"],
      "settings": {
        "foreground": "#6fbfb2",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Decorator",
      "scope": ["meta.decorator", "punctuation.decorator", "entity.name.function.decorator"],
      "settings": {
        "foreground": "#ff7a29",
        "fontStyle": "italic"
      }
    },
    {
      "name": "CSS selector",
      "scope": ["entity.name.tag.css", "entity.other.attribute-name.class.css", "entity.other.attribute-name.id.css", "entity.other.attribute-name.pseudo-class.css"],
      "settings": {
        "foreground": "#f5384f"
      }
    },
    {
      "name": "CSS property",
      "scope": ["support.type.property-name.css", "meta.property-name.css"],
      "settings": {
        "foreground": "#9fbcd4"
      }
    },
    {
      "name": "CSS value",
      "scope": ["support.constant.property-value.css", "constant.other.color", "constant.other.unit"],
      "settings": {
        "foreground": "#d9a441"
      }
    },
    {
      "name": "Preprocessor and import",
      "scope": ["keyword.control.import", "keyword.control.from", "keyword.control.export", "meta.preprocessor", "entity.name.function.preprocessor"],
      "settings": {
        "foreground": "#f5384f",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Invalid",
      "scope": ["invalid", "invalid.illegal"],
      "settings": {
        "foreground": "#ff6b81",
        "fontStyle": "underline"
      }
    },
    {
      "name": "Deprecated",
      "scope": ["invalid.deprecated"],
      "settings": {
        "foreground": "#947474",
        "fontStyle": "strikethrough"
      }
    },
    {
      "name": "Markdown heading",
      "scope": ["markup.heading", "entity.name.section"],
      "settings": {
        "foreground": "#fff5f0",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown bold",
      "scope": ["markup.bold"],
      "settings": {
        "foreground": "#f5384f",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown italic",
      "scope": ["markup.italic"],
      "settings": {
        "foreground": "#ebd9d2",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markdown link",
      "scope": ["markup.underline.link", "string.other.link"],
      "settings": {
        "foreground": "#ff7a29",
        "fontStyle": "underline"
      }
    },
    {
      "name": "Markdown quote",
      "scope": ["markup.quote"],
      "settings": {
        "foreground": "#a1837c",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markdown code",
      "scope": ["markup.inline.raw", "markup.fenced_code", "markup.raw"],
      "settings": {
        "foreground": "#d9a441"
      }
    },
    {
      "name": "Markdown list marker",
      "scope": ["punctuation.definition.list.begin.markdown", "beginning.punctuation.definition.list"],
      "settings": {
        "foreground": "#f5384f"
      }
    },
    {
      "name": "Diff inserted",
      "scope": ["markup.inserted"],
      "settings": {
        "foreground": "#57b894"
      }
    },
    {
      "name": "Diff deleted",
      "scope": ["markup.deleted"],
      "settings": {
        "foreground": "#ff6b81"
      }
    },
    {
      "name": "Diff changed",
      "scope": ["markup.changed"],
      "settings": {
        "foreground": "#d9a441"
      }
    }
  ],
  "semanticTokenColors": {
    "type": "#6fbfb2",
    "class": "#6fbfb2",
    "interface": "#6fbfb2",
    "struct": "#6fbfb2",
    "enum": "#6fbfb2",
    "enumMember": "#a06fbf",
    "typeParameter": "#93d8cc",
    "namespace": "#6fbfb2",
    "function": "#ff7a29",
    "method": "#ff7a29",
    "macro": "#ff7a29",
    "property": "#9fbcd4",
    "variable": "#ebd9d2",
    "parameter": "#a1837c",
    "keyword": {
      "foreground": "#f5384f",
      "fontStyle": "italic"
    },
    "comment": {
      "foreground": "#947474",
      "fontStyle": "italic"
    },
    "string": "#d9a441",
    "number": "#a06fbf",
    "operator": "#ff5a6e",
    "decorator": "#ff7a29",
    "selfKeyword": {
      "foreground": "#ff5a6e",
      "fontStyle": "italic"
    },
    "*.deprecated": {
      "fontStyle": "strikethrough"
    },
    "*.readonly": {
      "fontStyle": ""
    }
  }
}
