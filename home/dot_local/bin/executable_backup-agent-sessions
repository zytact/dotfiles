#!/usr/bin/env bash
# Backs up raw Claude Code, Codex and OpenCode sessions to the restic repo on R2.
# Credentials come from ~/.secrets. Snapshots are never pruned.
set -euo pipefail

. "$HOME/.secrets"
export AWS_ACCESS_KEY_ID=$R2_ACCESS_KEY_ID
export AWS_SECRET_ACCESS_KEY=$R2_SECRET_ACCESS_KEY
export AWS_DEFAULT_REGION=auto

paths=()
for p in ~/.claude/projects ~/.codex/sessions ~/.codex/archived_sessions ~/.local/share/opencode/tool-output; do
  [ -d "$p" ] && paths+=("$p")
done

# A plain copy of a live SQLite file can be corrupt, so snapshot it through the backup API.
db=~/.local/share/opencode/opencode.db
if [ -f "$db" ]; then
  staging=~/.cache/backup-agent-sessions
  mkdir -p "$staging"
  rm -f "$staging/opencode.db.tmp"
  python3 -c '
import sqlite3, sys
src = sqlite3.connect(f"file:{sys.argv[1]}?mode=ro", uri=True)
dst = sqlite3.connect(sys.argv[2])
src.backup(dst)
dst.close()
' "$db" "$staging/opencode.db.tmp"
  mv "$staging/opencode.db.tmp" "$staging/opencode.db"
  paths+=("$staging/opencode.db")
fi

restic backup --tag agent-sessions "${paths[@]}"
