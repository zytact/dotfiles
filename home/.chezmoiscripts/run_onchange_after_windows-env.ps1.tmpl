{{- if eq .chezmoi.os "windows" -}}
# Sets user environment variables, which every Windows process sees, including T3 and its scheduled runs.
# XDG gives tools that honour it (is-dl, nvim, lazygit, gh) the same layout as Linux.
# gh then reads ~/.config/gh, so its config.yml and hosts.yml moved there from %APPDATA%\GitHub CLI.
# Running processes keep their old environment, so restart T3 and terminals after a change.
$ErrorActionPreference = 'Stop'
$home_ = $env:USERPROFILE
$vars = @{
    XDG_CONFIG_HOME = "$home_\.config"
    XDG_DATA_HOME   = "$home_\.local\share"
    XDG_STATE_HOME  = "$home_\.local\state"
    XDG_CACHE_HOME  = "$home_\.cache"
}
foreach ($name in $vars.Keys) { [Environment]::SetEnvironmentVariable($name, $vars[$name], 'User') }

# Python's real launchers go ahead of the WindowsApps aliases, which nvim's executable() rejects.
$pythonBin = "$env:LOCALAPPDATA\Python\bin"
$path = @($pythonBin) + ([Environment]::GetEnvironmentVariable('Path', 'User') -split ';' | Where-Object { $_ -and $_ -ne $pythonBin })
# WinLibs gcc builds nvim-treesitter parsers.
$winlibs = "$env:LOCALAPPDATA\Microsoft\WinGet\Packages\BrechtSanders.WinLibs.POSIX.UCRT_Microsoft.Winget.Source_8wekyb3d8bbwe\mingw64\bin"
foreach ($dir in "$home_\.opencode\bin", "$home_\.local\bin\agent-desktop", "$home_\.local\bin\tectonic", "$home_\.local\share\is-dl\current\node_modules\.bin", $winlibs) {
    if ($path -notcontains $dir) { $path += $dir }
}
[Environment]::SetEnvironmentVariable('Path', ($path -join ';'), 'User')
{{- end }}
