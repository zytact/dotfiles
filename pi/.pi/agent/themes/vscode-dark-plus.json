{
  "$schema": "https://raw.githubusercontent.com/earendil-works/pi/main/packages/coding-agent/src/modes/interactive/theme/theme-schema.json",
  "name": "vscode-dark-plus",
  "vars": {
    "bg": "#1e1e1e",
    "panel": "#252526",
    "panelAlt": "#2d2d30",
    "panelSoft": "#333333",
    "select": "#264f78",
    "blue": "#569cd6",
    "blueBright": "#4fc1ff",
    "cyan": "#4ec9b0",
    "green": "#6a9955",
    "red": "#f44747",
    "orange": "#ce9178",
    "yellow": "#dcdcaa",
    "purple": "#c586c0",
    "fg": "#d4d4d4",
    "fgSoft": "#c8c8c8",
    "fgMuted": "#9da1a6",
    "fgDim": "#808080"
  },
  "colors": {
    "accent": "blueBright",
    "border": "panelSoft",
    "borderAccent": "blue",
    "borderMuted": "#3e3e42",
    "success": "green",
    "error": "red",
    "warning": "yellow",
    "muted": "fgMuted",
    "dim": "fgDim",
    "text": "fg",
    "thinkingText": "fgSoft",

    "selectedBg": "select",
    "userMessageBg": "panel",
    "userMessageText": "fg",
    "customMessageBg": "panelAlt",
    "customMessageText": "fg",
    "customMessageLabel": "blueBright",
    "toolPendingBg": "panel",
    "toolSuccessBg": "#1f2a1f",
    "toolErrorBg": "#3a1f1f",
    "toolTitle": "blue",
    "toolOutput": "fgSoft",

    "mdHeading": "blueBright",
    "mdLink": "blueBright",
    "mdLinkUrl": "fgMuted",
    "mdCode": "orange",
    "mdCodeBlock": "fg",
    "mdCodeBlockBorder": "#3e3e42",
    "mdQuote": "fgSoft",
    "mdQuoteBorder": "#3e3e42",
    "mdHr": "#3e3e42",
    "mdListBullet": "blueBright",

    "toolDiffAdded": "green",
    "toolDiffRemoved": "red",
    "toolDiffContext": "fgMuted",

    "syntaxComment": "green",
    "syntaxKeyword": "blue",
    "syntaxFunction": "yellow",
    "syntaxVariable": "fg",
    "syntaxString": "orange",
    "syntaxNumber": "cyan",
    "syntaxType": "cyan",
    "syntaxOperator": "fgSoft",
    "syntaxPunctuation": "fgMuted",

    "thinkingOff": "#3e3e42",
    "thinkingMinimal": "fgDim",
    "thinkingLow": "blue",
    "thinkingMedium": "blueBright",
    "thinkingHigh": "purple",
    "thinkingXhigh": "red",

    "bashMode": "cyan"
  },
  "export": {
    "pageBg": "bg",
    "cardBg": "panel",
    "infoBg": "panelAlt"
  }
}
