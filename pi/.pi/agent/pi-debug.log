get(model_id)\n    if not pricing:\n        return None\n    prompt = as_decimal(pricing.get(\"prompt\")) or Decimal(\"0\")\n    completion = as_decimal(pricing.get(\"completion\")) or Decimal(\"0\")\n    cache_read = as_decimal(pricing.get(\"cache_read\")) or Decimal(\"0\")\n    input_tokens = Decimal(token_info.get(\"input\", 0) or 0)\n    output_tokens = Decimal(token_info.get(\"output\", 0) or 0)\n    cached_tokens = Decimal(token_info.get(\"cached\", 0) or 0)\n    input_cost = input_tokens * prompt\n    cache_cost = cached_tokens * cache_read\n    output_cost = output_tokens * completion\n    total_cost = input_cost + cache_cost + output_cost\n    return {\n        \"input\": input_cost,\n        \"cached\": cache_cost,\n        \"output\": output_cost,\n        \"total\": total_cost,\n    }\n\n\ndef usd(value: Decimal | None) -> str:\n    if value is None:\n        return \"n/a\"\n    if value == 0:\n        return \"$0.00\"\n    if value < Decimal(\"0.01\"):\n        return f\"${value:.4f}\"\n    return f\"${value:.2f}\"\n\n\ndef usd_per_million(value: Decimal | None) -> str:\n    if value is None:\n        return \"n/a\"\n    per_million = value * Decimal(\"1000000\")\n    if per_million == 0:\n        return \"$0/M\"\n    if per_million < Decimal(\"0.01\"):\n        return f\"${per_million:.4f}/M\"\n    if per_million < Decimal(\"1\"):\n        return f\"${per_million:.3f}/M\"\n    retur\n\nNEEDLE MODEL_ALIASES 2256\nMODEL_ALIASES = {\n    \"gpt-5.3-codex\": \"openai/gpt-5.3-codex\",\n    \"gpt-5.4\": \"openai/gpt-5.4\",\n    \"gpt-5.4-mini\": \"openai/gpt-5.4-mini\",\n    \"gpt-5.5\": \"openai/gpt-5.5\",\n    \"claude-sonnet-4-6\": \"anthropic/claude-sonnet-4.6\",\n    \"claude-opus-4-6\": \"anthropic/claude-opus-4.6\",\n    \"claude-opus-4-7\": \"anthropic/claude-opus-4.7\",\n    \"claude-haiku-4-5-20251001\": \"anthropic/claude-haiku-4.5\",\n    \"deepseek-v4-flash-free\": \"deepseek/deepseek-v4-flash:free\",\n    \"deepseek-v4-flash\": \"deepseek/deepse