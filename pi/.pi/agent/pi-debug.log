{"role":"toolResult","toolCallId":"call_M4R92bPgNAkNeWifdKByQEgz|fc_00cd299e6620f93c016a246ed4167c81918d8e62001ba877f4","toolName":"read","content":[{"type":"text","text":"#!/usr/bin/env bash\nset -euo pipefail\n\nMODE=\"pretty\"\n\nusage() {\n  cat <<'EOF'\nUsage: codex-usage [--json|--shell]\n\nOptions:\n  --json   Print machine-readable JSON instead of the formatted dashboard\n  --shell  Print shell-friendly KEY=VALUE lines\n  -h, --help\nEOF\n}\n\nwhile [[ $# -gt 0 ]]; do\n  case \"$1\" in\n    --json)\n      MODE=\"json\"\n      shift\n      ;;\n    --shell)\n      MODE=\"shell\"\n      shift\n      ;;\n    -h|--help)\n      usage\n      exit 0\n      ;;\n    *)\n      echo \"Unknown argument: $1\" >&2\n      usage >&2\n      exit 1\n      ;;\n  esac\ndone\n\nAUTH_FILE=\"${CODEX_HOME:-$HOME/.codex}/auth.json\"\n\nif ! command -v jq >/dev/null 2>&1; then\n  echo \"Missing jq. Install it:\"\n  echo \"  sudo dnf install jq\"\n  exit 1\nfi\n\nif [[ ! -f \"$AUTH_FILE\" ]]; then\n  echo \"Codex auth file not found: $AUTH_FILE\"\n  exit 1\nfi\n\n# Colors\nBOLD=$'\\033[1m'\nDIM=$'\\033[2m'\nRESET=$'\\033[0m'\nRED=$'\\033[31m'\nGREEN=$'\\033[32m'\nYELLOW=$'\\033[33m'\nBLUE=$'\\033[34m'\nMAGENTA=$'\\033[35m'\nCYAN=$'\\033[36m'\nWHITE=$'\\033[37m'\n\nBRIGHT_RED=$'\\033[91m'\nBRIGHT_GREEN=$'\\033[92m'\nBRIGHT_YELLOW=$'\\033[93m'\nBRIGHT_BLUE=$'\\033[94m'\nBRIGHT_MAGENTA=$'\\033[95m'\nBRIGHT_CYAN=$'\\033[96m'\n\nACCESS_TOKEN=\"$(jq -r '\n  .tokens.access_token\n  // .tokens.access\n  // .access_token\n  // .access\n  // .chatgptAuthTokens.access_token\n  // .chatgpt_auth.access_token\n  // empty\n' \"$AUTH_FILE\")\"\n\nACCOUNT_ID=\"$(jq -r '\n  .account_id\n  // .accountId\n  // .tokens.account_id\n  // .tokens.accountId\n  // .chatgpt_account_id\n  // .chatgptAccountId\n  // empty\n' \"$AUTH_FILE\")\"\n\nif [[ -z \"$ACCESS_TOKEN\" || \"$ACCESS_TOKEN\" == \"null\" ]]; then\n  echo \"Could not find access token in $AUTH_FILE\"\n  exit 1\nfi\n\nfmt_eta() {\n  local seconds=\"$1\"\n\n  if [[ -z \"$seconds\" || \"$seconds\" == \"null\" ]]; then\n    echo \"unknown\"\n    return\n  fi\n\n  seconds=\"${seconds%.*}\"\n\n  if (( seconds <= 0 )); then\n    echo \"resetting now\"\n    return\n  fi\n\n  local d=$(( seconds / 86400 ))\n  local h=$(( (seconds % 86400) / 3600 ))\n  local m=$(( (seconds % 3600) / 60 ))\n\n  if (( d > 0 )); then\n    echo \"${d}d ${h}h ${m}m\"\n  elif (( h > 0 )); then\n    echo \"${h}h ${m}m\"\n  else\n    echo \"${m}m\"\n  fi\n}\n\nfmt_abs_time_from_reset_seconds() {\n  local seconds=\"$1\"\n\n  if [[ -z \"$seconds\" || \"$seconds\" == \"null\" ]]; then\n    echo \"unknown\"\n    return\n  fi\n\n  seconds=\"${seconds%.*}\"\n  local target=$(( $(date +%s) + seconds ))\n\n  date -d \"@$target\" \"+%a, %d %b %I:%M %p\" 2>/dev/null \\\n    || date -r \"$target\" \"+%a, %d %b %I:%M %p\"\n}\n\nusage_color() {\n  local used=\"${1%.*}\"\n\n  if (( used < 40 )); then\n    echo \"$BRIGHT_GREEN\"\n  elif (( used < 70 )); then\n    echo \"$BRIGHT_YELLOW\"\n  elif (( used < 90 )); then\n    echo \"$YELLOW\"\n  else\n    echo \"$BRIGHT_RED\"\n  fi\n}\n\nbar() {\n  local used=\"${1%.*}\"\n  local width=24\n  local filled=$(( used * width / 100 ))\n  local empty=$(( width - filled ))\n  local color\n  color=\"$(usage_color \"$used\")\"\n\n  printf \"%s\" \"$color\"\n  printf \"%0.s█\" $(seq 1 \"$filled\" 2>/dev/null)\n  printf \"%s\" \"$DIM\"\n  printf \"%0.s░\" $(seq 1 \"$empty\" 2>/dev/null)\n  printf \"%s\" \"$RESET\"\n}\n\nfetch_usage() {\n  local url=\"$1\"\n\n  if [[ -n \"$ACCOUNT_ID\" && \"$ACCOUNT_ID\" != \"null\" ]]; then\n    curl -fsS \"$url\" \\\n      -H \"Authorization: Bearer $ACCESS_TOKEN\" \\\n      -H \"chatgpt-account-id: $ACCOUNT_ID\" \\\n      -H \"accept: application/json\"\n  else\n    curl -fsS \"$url\" \\\n      -H \"Authorization: Bearer $ACCESS_TOKEN\" \\\n      -H \"accept: application/json\"\n  fi\n}\n\nTMP=\"$(mktemp)\"\ntrap 'rm -f \"$TMP\"' EXIT\n\nif ! fetch_usage \"https://chatgpt.com/backend-api/wham/usage\" > \"$TMP\"; then\n  if ! fetch_usage \"https://chatgpt.com/backend-api/codex/usage\" > \"$TMP\"; then\n    echo \"Usage request failed.\"\n    exit 1\n  fi\nfi\n\nPRIMARY_USED=\"$(jq -r '.rate_limit.primary_window.used_percent // empty' \"$TMP\")\"\nSECONDARY_USED=\"$(jq -r '.rate_limit.secondary_window.used_percent // empty' \"$TMP\")\"\n\nPRIMARY_RESET_SECONDS=\"$(jq -r '\n  .rate_limit.primary_window.reset_after_seconds\n  // (\n    if .rate_limit.primary_window.reset_at then\n      (\n        (\n          if .rate_limit.primary_window.reset_at > 100000000000\n          then .rate_limit.primary_window.reset_at / 1000\n          else .rate_limit.primary_window.reset_at\n          end\n        ) - now\n      )\n    else empty end\n  )\n' \"$TMP\")\"\n\nSECONDARY_RESET_SECONDS=\"$(jq -r '\n  .rate_limit.secondary_window.reset_after_seconds\n  // (\n    if .rate_limit.secondary_window.reset_at then\n      (\n        (\n          if .rate_limit.secondary_window.reset_at > 100000000000\n          then .rate_limit.secondary_window.reset_at / 1000\n          else .rate_limit.secondary_window.reset_at\n          end\n        ) - now\n      )\n    else empty end\n  )\n' \"$TMP\")\"\n\nLIMIT_REACHED=\"$(jq -r '.rate_limit.limit_reached // false' \"$TMP\")\"\nALLOWED=\"$(jq -r '.rate_limit.allowed // true' \"$TMP\")\"\n\nnow_epoch=\"$(date +%s)\"\n\nnormalize_seconds() {\n  local seconds=\"${1:-}\"\n\n  if [[ -z \"$seconds\" || \"$seconds\" == \"null\" ]]; then\n    echo \"\"\n    return\n  fi\n\n  printf '%s\\n' \"${seconds%.*}\"\n}\n\nPRIMARY_RESET_SECONDS=\"$(normalize_seconds \"$PRIMARY_RESET_SECONDS\")\"\nSECONDARY_RESET_SECONDS=\"$(normalize_seconds \"$SECONDARY_RESET_SECONDS\")\"\n\nPRIMARY_RESET_AT_EPOCH=\"\"\nSECONDARY_RESET_AT_EPOCH=\"\"\n\nif [[ -n \"$PRIMARY_RESET_SECONDS\" ]]; then\n  PRIMARY_RESET_AT_EPOCH=$(( now_epoch + PRIMARY_RESET_SECONDS ))\nfi\n\nif [[ -n \"$SECONDARY_RESET_SECONDS\" ]]; then\n  SECONDARY_RESET_AT_EPOCH=$(( now_epoch + SECONDARY_RESET_SECONDS ))\nfi\n\nif [[ \"$MODE\" == \"json\" ]]; then\n  jq -n \\\n    --argjson now_epoch \"$now_epoch\" \\\n\n[84 more lines in file. Use offset=261 to continue.]"}],"isError":false,"timestamp":1780772565321}
