{"role":"toolResult","toolCallId":"call_vBNhaSprK4z1kR9Q0VsBvurr|fc_00cd299e6620f93c016a246e8d6f1481919ad72c8a1bfd59fd","toolName":"read","content":[{"type":"text","text":"#!/usr/bin/env bash\nset -euo pipefail\n\nif ! command -v gum >/dev/null 2>&1; then\n  echo \"Missing gum. Install it first.\"\n  exit 1\nfi\n\nif ! command -v python3 >/dev/null 2>&1; then\n  echo \"Missing python3.\"\n  exit 1\nfi\n\nSCRIPT_DIR=\"$(cd -- \"$(dirname -- \"${BASH_SOURCE[0]}\")\" && pwd)\"\n\nusage() {\n  cat <<'EOF'\nUsage: agent-usage [--claude]\n\nOptions:\n  --claude   Include Claude Code usage from ~/.claude/projects\n  -h, --help Show this help\nEOF\n}\n\nINCLUDE_CLAUDE=0\nwhile [[ $# -gt 0 ]]; do\n  case \"$1\" in\n    --claude)\n      INCLUDE_CLAUDE=1\n      shift\n      ;;\n    -h|--help)\n      usage\n      exit 0\n      ;;\n    *)\n      echo \"Unknown argument: $1\" >&2\n      usage >&2\n      exit 1\n      ;;\n  esac\ndone\n\nrender_report() {\n  local scope=\"$1\"\n  local include_claude=\"$2\"\n  python3 - \"$scope\" \"$include_claude\" <<'PY'\nimport datetime as dt\nimport json\nimport os\nimport re\nimport sys\nimport urllib.request\nfrom collections import Counter, defaultdict\nfrom decimal import Decimal, InvalidOperation\nfrom pathlib import Path\n\nSCOPE = sys.argv[1]\nINCLUDE_CLAUDE = sys.argv[2] == \"1\"\nHOME = Path.home()\nNOW = dt.datetime.now().astimezone()\nTODAY = NOW.date()\n\nCODEX_DIR = HOME / \".codex\" / \"sessions\"\nCLAUDE_DIR = HOME / \".claude\" / \"projects\"\nPI_LINK = HOME / \".pi\"\nPI_HOME = PI_LINK.resolve() if PI_LINK.exists() else PI_LINK\nPI_DIR = PI_HOME / \"agent\" / \"sessions\"\n\nACTIVE_GAP_SECONDS = 15 * 60\nEXTENSION_LANGS = {\n    \".py\": \"Python\",\n    \".ts\": \"TypeScript\",\n    \".tsx\": \"TSX\",\n    \".js\": \"JavaScript\",\n    \".jsx\": \"JSX\",\n    \".rs\": \"Rust\",\n    \".go\": \"Go\",\n    \".java\": \"Java\",\n    \".c\": \"C\",\n    \".cc\": \"C++\",\n    \".cpp\": \"C++\",\n    \".h\": \"C/C++ Header\",\n    \".hpp\": \"C++ Header\",\n    \".sh\": \"Shell\",\n    \".zsh\": \"Shell\",\n    \".bash\": \"Shell\",\n    \".json\": \"JSON\",\n    \".jsonl\": \"JSONL\",\n    \".toml\": \"TOML\",\n    \".yaml\": \"YAML\",\n    \".yml\": \"YAML\",\n    \".md\": \"Markdown\",\n    \".html\": \"HTML\",\n    \".css\": \"CSS\",\n    \".scss\": \"SCSS\",\n    \".sql\": \"SQL\",\n    \".lua\": \"Lua\",\n    \".rb\": \"Ruby\",\n    \".php\": \"PHP\",\n    \".swift\": \"Swift\",\n    \".kt\": \"Kotlin\",\n    \".tsx\": \"TSX\",\n    \".tsx\": \"TSX\",\n}\n\nFILE_PATH_RE = re.compile(r'([/~]?[A-Za-z0-9._/\\- ]+\\.[A-Za-z0-9]+)')\nMODELS_DEV_URL = \"https://raw.githubusercontent.com/anomalyco/models.dev/dev/models.json\"\nMODEL_ALIASES = {\n    \"gpt-5.3-codex\": \"openai/gpt-5.3-codex\",\n    \"gpt-5.4\": \"openai/gpt-5.4\",\n    \"gpt-5.4-mini\": \"openai/gpt-5.4-mini\",\n    \"gpt-5.5\": \"openai/gpt-5.5\",\n    \"claude-sonnet-4-6\": \"anthropic/claude-sonnet-4.6\",\n    \"claude-opus-4-6\": \"anthropic/claude-opus-4.6\",\n    \"claude-opus-4-7\": \"anthropic/claude-opus-4.7\",\n    \"claude-haiku-4-5-20251001\": \"anthropic/claude-haiku-4.5\",\n    \"deepseek-v4-flash-free\": \"deepseek/deepseek-v4-flash:free\",\n    \"deepseek-v4-flash\": \"deepseek/deepseek-v4-flash\",\n}\n\n\ndef parse_ts(value: str) -> dt.datetime | None:\n    try:\n        return dt.datetime.fromisoformat(value.replace(\"Z\", \"+00:00\")).astimezone()\n    except Exception:\n        return None\n\n\ndef scope_start(scope: str) -> dt.datetime:\n    if scope == \"today\":\n        return NOW.replace(hour=0, minute=0, second=0, microsecond=0)\n    if scope == \"7d\":\n        start_day = TODAY - dt.timedelta(days=6)\n        return dt.datetime.combine(start_day, dt.time.min, NOW.tzinfo)\n    if scope == \"30d\":\n        start_day = TODAY - dt.timedelta(days=29)\n        return dt.datetime.combine(start_day, dt.time.min, NOW.tzinfo)\n    raise ValueError(f\"unknown scope: {scope}\")\n\n\ndef repo_name(cwd: str | None) -> str:\n    if not cwd:\n        return \"unknown\"\n    parts = Path(cwd).parts\n    if \"Projects\" in parts:\n        idx = parts.index(\"Projects\")\n        if idx + 1 < len(parts):\n            return parts[idx + 1]\n    if \"dotfiles\" in parts:\n        idx = parts.index(\"dotfiles\")\n        if idx + 1 < len(parts):\n            return f\"dotfiles/{parts[idx + 1]}\"\n    return Path(cwd).name or cwd\n\n\ndef infer_languages(text: str) -> Counter:\n    counts: Counter[str] = Counter()\n    for match in FILE_PATH_RE.findall(text):\n        ext = Path(match.strip()).suffix.lower()\n        lang = EXTENSION_LANGS.get(ext)\n        if lang:\n            counts[lang] += 1\n    return counts\n\n\ndef merge_counter(target: Counter, source: Counter) -> None:\n    for key, value in source.items():\n        target[key] += value\n\n\ndef iter_jsonl_files(root: Path):\n    if not root.exists():\n        return []\n    return sorted(root.rglob(\"*.jsonl\"))\n\n\ndef codex_session_stats(path: Path):\n    session_id = None\n    cwd = None\n    events: list[dt.datetime] = []\n    token_total = {\"input\": 0, \"cached\": 0, \"output\": 0, \"reasoning\": 0, \"total\": 0}\n    langs: Counter[str] = Counter()\n    model_counts: Counter[str] = Counter()\n    effort_counts: Counter[str] = Counter()\n\n    with path.open() as f:\n        for line in f:\n            line = line.strip()\n            if not line:\n                continue\n            langs.update(infer_languages(line))\n            try:\n                item = json.loads(line)\n            except Exception:\n                continue\n            if not isinstance(item, dict):\n                continue\n            ts = parse_ts(item.get(\"timestamp\", \"\"))\n            if ts:\n                events.append(ts)\n            if item.get(\"type\") == \"session_meta\":\n                payload = item.get(\"payload\") or {}\n                if not isinstance(payload, dict):\n                    payload = {}\n                session_id = payload.get(\"id\")\n                cwd = payload.get(\"cwd\")\n            payload = item.get(\"payload\") or {}\n            if not isinstance(payload, dict):\n                payload = {}\n            if item.get(\"type\") == \"turn_context\":\n                model_name = payload.get(\"model\")\n                if model_name:\n                    model_counts[str(model_name)] += 1\n                effort_name = payload.get(\"effort\")\n                if effort_name:\n                    effort_counts[str(effort_name)] += 1\n                collaboration = payload.get(\"collaboration_mode\") or {}\n                if isinstance(collaboration, dict):\n                    settings = collaboration.get(\"settings\") or {}\n                    if isinstance(settings, dict):\n                        setting_effort = settings.get(\"reasoning_effort\")\n                        if setting_effort and not effort_name:\n                            effort_counts[str(setting_effort)] += 1\n            if item.get(\"type\") == \"event_msg\" and payload.get(\"type\") == \"token_count\":\n                info = payload.get(\"info\") or {}\n                if not isinstance(info, dict):\n                    info = {}\n                info = info.get(\"total_token_usage\") or {}\n                if not isinstance(info, dict):\n                    info = {}\n                input_tokens = int(info.get(\"input_tokens\", 0) or 0)\n                cached_tokens = int(info.get(\"cached_input_tokens\", 0) or 0)\n                output_tokens = int(info.get(\"output_tokens\", 0) or 0)\n                token_total = {\n                    \"input\": input_tokens,\n                    \"cached\": cached_tokens,\n                    \"output\": output_tokens,\n                    \"reasoning\": int(info.get(\"reasoning_output_tokens\", 0) or 0),\n                    \"total\": input_tokens + cached_tokens + output_tokens,\n                }\n\n    if not events:\n        return None\n    events.sort()\n    active = 0\n    for prev, cur in zip(events, events[1:]):\n        delta = int((cur - prev).total_seconds())\n        if delta > 0:\n            active += min(delta, ACTIVE_GAP_SECONDS)\n    if active == 0:\n        active = 60\n\n    model_tokens: dict[str, dict[str, int]] = {}\n    total_model_marks = sum(model_counts.values()) or 0\n    if total_model_marks > 0:\n        for model_name, marks in model_counts.items():\n            ratio = marks / total_model_marks\n            model_tokens[model_name] = {\n\n[654 more lines in file. Use offset=261 to continue.]"}],"isError":false,"timestamp":1780772493930}
