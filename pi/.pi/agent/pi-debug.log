    return Decimal(str(value))\n    except (InvalidOperation, ValueError):\n        return None\n\n\ndef estimate_cost_breakdown_usd(model_name: str, token_info: dict, pricing_map: dict) -> dict | None:\n    model_id = MODEL_ALIASES.get(model_name, model_name)\n    pricing = pricing_map.get(model_id)\n    if not pricing:\n        return None\n    prompt = as_decimal(pricing.get(\"prompt\")) or Decimal(\"0\")\n    completion = as_decimal(pricing.get(\"completion\")) or Decimal(\"0\")\n    cache_read = as_decimal(pricing.get(\"cache_read\")) or Decimal(\"0\")\n    input_tokens = Decimal(token_info.get(\"input\", 0) or 0)\n    output_tokens = Decimal(token_info.ge\n\nNEEDLE rate 21280\nrate = usd_per_million(as_decimal(pricing.get(\"prompt\")))\n        completion_rate = usd_per_million(as_decimal(pricing.get(\"completion\")))\n        costs = estimate_cost_breakdown_usd(model, token_info, pricing_map)\n        rows.append((\n            model,\n            f\"{pct:.0f}% · in {compact_tokens(token_info.get('input', 0))} ({prompt_rate})\"\n            f\" · out {compact_tokens(token_info.get('output', 0))} ({completion_rate})\"\n            f\" · est {usd(costs['total']) if costs else 'n/a'}\",\n            pct,\n        ))\n    return rows\n\n\ndef estimate_stats_total_cost(stats: dict, pricing_map: dict) -> Decimal | None:\n    total_cost = Decimal(\"0\")\n    found_any = False\n    for model_name, token_info in stats.get(\"model_tokens\", {}).items():\n        costs = estimate_cost_breakdown_usd(model_name, token_info, pricing_map)\n        if not costs:\n            continue\n        total_cost += costs[\"total\"]\n        found_any = True\n    return total_cost if found_any else None\n\n\ndef glam_bar_list_block(title: str, rows: list[tuple[str, str, float]], accent: str, glow: str, badge: str, note: str | None = None) -> list[str]:\n    out = [\n        f\"  {color('╭─ ' + badge + ' ' + title.upper(), '1;' + glow)}\",\n        f\"  {color('│', accent)} {dim(note)}