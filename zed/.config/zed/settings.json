// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "cli_default_open_behavior": "new_window",
  "project_panel": {
    "dock": "left",
  },
  "outline_panel": {
    "dock": "left",
  },
  "collaboration_panel": {
    "dock": "left",
  },
  "git_panel": {
    "dock": "left",
  },
  "window_decorations": "client",
  "terminal": {
    "default_height": 521.0,
  },
  "disable_ai": true,
  "redact_private_values": false,
  "format_on_save": "on",
  "icon_theme": {
    "mode": "dark",
    "light": "Material Icon Theme",
    "dark": "Catppuccin Mocha"
  },
  "show_edit_predictions": false,
  "agent": {
    "dock": "right",
    "default_profile": "write",
    "default_model": {
      "provider": "copilot_chat",
      "model": "gpt-5-mini",
    },
  },
  "vim_mode": false,
  "vim": {
    "use_system_clipboard": "never",
  },
  "telemetry": {
    "metrics": false,
  },
  "ui_font_size": 11.0,
  "ui_font_family": "JetBrainsMono Nerd Font",
  "buffer_font_family": "JetBrainsMono Nerd Font",
  "buffer_font_weight": 450,
  "buffer_font_size": 10.0,
  "tab_bar": {
    "show": true,
  },
  "buffer_line_height": {
    "custom": 1.5,
  },
  "relative_line_numbers": "enabled",
  "theme": {
    "mode": "light",
    "light": "Targaryen Light",
    "dark": "Targaryen"
  },
  "languages": {
    "Python": {
      "language_servers": ["pyright", "ruff"],
      "format_on_save": "off",
      "formatter": [
        {
          "code_action": "source.organizeImports.ruff",
        },
        {
          "code_action": "source.fixAll.ruff",
        },
        {
          "language_server": {
            "name": "ruff",
          },
        },
      ],
    },
  },
  "inlay_hints": {
    "enabled": false,
    "show_background": true,
    "show_type_hints": false,
  },
  "auto_signature_help": false,
  "experimental.theme_overrides": {
    "syntax": {
      "comment": {
        "font_style": "italic",
      },
      "comment.doc": {
        "font_style": "italic",
      },
      "keyword": {
        "font_style": "italic",
      },
    },
  },
  "lsp": {
    "rust-analyzer": {
      "initialization_options": {
        // get more cargo-less diagnostics from rust-analyzer,
        // which might include false-positives (those can be turned off by their names)
        "diagnostics": {
          "experimental": {
            "enable": true,
          },
        },
        // To disable the checking entirely
        // (ignores all cargo and check settings below)
        "checkOnSave": false,
      },
    },
  },
}
